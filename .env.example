# ============================================================================
# Route M8 — Production-Ready Environment Configuration Template
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Canonical Database: MongoDB Atlas (Mongoose ODM)
# ----------------------------------------------------------------------------
# Production MongoDB Atlas Connection URI (Server-Side Only)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/routem8?retryWrites=true&w=majority

# Supabase Project Endpoint & Anon Key (Archived reference / Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ----------------------------------------------------------------------------
# 2. Authentication: Firebase Auth & Firebase Admin SDK
# ----------------------------------------------------------------------------
# Firebase Client SDK Configuration (Safe for client exposure)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server-Side Firebase Admin ID Token Verification
FIREBASE_PROJECT_ID=your-project-id
# Path to serviceAccountKey.json or raw JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ----------------------------------------------------------------------------
# 3. Realtime Audio Calling (LiveKit WebRTC)
# ----------------------------------------------------------------------------
# Client LiveKit Gateway Endpoint
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
# Backend LiveKit Token Minting (Server-Side Secrets)
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ----------------------------------------------------------------------------
# 4. Maps & Routing Configuration
# ----------------------------------------------------------------------------
# OpenStreetMap & Leaflet with OSRM (Default, completely free-tier)
# Optional: Google Maps Platform API Key (if enabled)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ----------------------------------------------------------------------------
# 5. Server Port & Security
# ----------------------------------------------------------------------------
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://route-m8.vercel.app
