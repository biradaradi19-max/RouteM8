# ============================================================================
# Route M8 — Environment Configuration Template
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Backend Server & Database (Node.js + Express + MongoDB)
# ----------------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/routem8?retryWrites=true&w=majority

# ----------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Side ID-Token Verification)
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=routem8-36895
# Path to serviceAccountKey.json or raw JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ----------------------------------------------------------------------------
# 3. LiveKit Audio Calling (Minted exclusively on Express backend)
# ----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ----------------------------------------------------------------------------
# 4. Frontend Client Environment Variables (VITE_ prefixed)
# ----------------------------------------------------------------------------
# Firebase Client Authentication
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=routem8-36895.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=routem8-36895
VITE_FIREBASE_STORAGE_BUCKET=routem8-36895.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# LiveKit WebRTC Audio Endpoint
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# Backend API & Socket URL (Optional: configure if frontend is deployed on Vercel and backend is on separate host)
# VITE_API_BASE_URL=https://your-routem8-api.onrender.com
# VITE_SERVER_URL=https://your-routem8-api.onrender.com
