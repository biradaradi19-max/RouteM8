# Route M8 — Environment Configuration
# Provide these in .env (or .env.local) for local development or in production hosting platform

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous Client Key (Browser safe; access is restricted by Postgres Row Level Security)
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Server-Side Admin & CLI only — NEVER prefix with VITE_)
# Required for server-side administrative tools, user confirmation scripts, and edge tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform API Key (or free Maps Demo Key from https://mapsplatform.google.com/maps-demo-key)
# When set, enables Google Maps with Advanced Markers, Live GPS rendering, and route corridors
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Cloud Map ID (defaults to DEMO_MAP_ID for AdvancedMarkerElement prototyping)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# LiveKit WebRTC Audio Calling (Browser Safe URL)
# Example: wss://routem8-your-project.livekit.cloud
VITE_LIVEKIT_URL=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ============================================================================
# Supabase Edge Function Secrets (Set via `supabase secrets set` or Dashboard)
# NEVER put these in frontend Vite code or commit to source control!
# ============================================================================
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_URL=wss://routem8-your-project.livekit.cloud

