# Google Maps Platform Configuration (Optional)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# LiveKit WebRTC Audio Calling (Optional)
VITE_LIVEKIT_URL=
